# Production environment — deployed to Firebase Hosting (vahnly-platform).
# Firebase Hosting is a static file host with NO proxy capability, so the
# admin SPA must make cross-origin requests directly to the API gateway.
# The gateway must include this origin in ALLOWED_ORIGINS and accept
# credentials: 'include' (SameSite=None; Secure cookies).

VITE_GATEWAY_BASE_URL=https://api.aniket.site
VITE_ANALYTICS_BASE_URL=https://api.aniket.site
VITE_GOOGLE_MAPS_API_KEY=your_key_here
VITE_SENTRY_DSN=
VITE_ENV=production
